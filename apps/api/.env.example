# API port
PORT=3000
# Comma-separated list of allowed browser origins (omit to allow all)
# CORS_ORIGIN=http://localhost:4200

# SQL Server 2022 connection
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=ProjectManagement
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Create DB_NAME on startup if it does not exist (needs CREATE DATABASE permission)
DB_CREATE_DATABASE=true
# Apply pending TypeORM migrations on startup
DB_MIGRATIONS_RUN=true
# Auto-sync schema from entities (development only - never in production)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Sign-in tokens. Use a long random value in production (required when NODE_ENV=production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# First manager account, created on startup when no manager can sign in yet
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe@123
# ADMIN_NAME=Administrator

# Insert sample projects/tasks/team when the database is empty
# (demo accounts use the password Password@123)
SEED_DEMO_DATA=true
