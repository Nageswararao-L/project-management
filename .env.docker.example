# Copy to `.env` (next to docker-compose.yml) to change the Docker settings.
# Every value is optional; the defaults are shown.

# Port of the web app on your computer -> http://localhost:8080
WEB_PORT=8080
# Port of SQL Server on your computer (for SSMS / Azure Data Studio)
MSSQL_PORT=1433

# SQL Server "sa" password: at least 8 characters with upper, lower, digit and symbol.
# Only takes effect when the database volume is first created.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
DB_NAME=ProjectManagement

# Secret that signs sign-in tokens: use a long random value.
JWT_SECRET=change-me-local-docker-secret
JWT_EXPIRES_IN=12h

# Sample projects, tasks and team (all demo passwords: Password@123).
# Set to false for real use and create your manager account below.
SEED_DEMO_DATA=true

# First manager account, created on startup if no manager can sign in yet.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=ChangeMe@123
# ADMIN_NAME=Your Name
